<kitsunePosters>
	<!-- Domains posters may load images from, comma separated. "*" allows every
	     domain. An entry matches the host and its subdomains, so "imgur.com"
	     also allows "i.imgur.com". The SERVER's copy is the one that counts:
	     it blanks disallowed URLs out of the sign text for everyone. Example:
	     <property name="AllowedDomains" value="imgur.com,discordapp.com,discordapp.net"/> -->
	<property name="AllowedDomains" value="*"/>

	<!-- Default for THIS machine: download and show poster images at all.
	     Players can change it in game any time with: kposters on|off -->
	<property name="ShowRemoteImages" value="true"/>
</kitsunePosters>
