<configs>
	<append xpath="/blocks">

		<!-- Frameless poster boards (own bundle). The sign tile entity stores
		     the URL; the DLL draws the image. Tiling across neighbours is for
		     the 1x1 only - bigger walls, use the bigger posters. -->
		<block name="kitsunePoster1x1">
			<property name="Extends" value="playerSignWood1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureSignable">
					<property name="FontSize" value="110"/>
					<property name="LineCount" value="3"/>
					<property name="LineWidth" value="0.9"/>
					<property name="LineSpacing" value="1"/>
				</property>
				<property class="TEFeatureLockable"/>
				<!-- E > Take. Extends deep-merges CompositeFeatures, so every
				     size and the graffiti inherit it. The DLL replaces vanilla's
				     own-land-claim-only rule with the usual pickup rule. -->
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="1"/>
				</property>
			</property>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?poster_1x1"/>
			<property name="DescriptionKey" value="kitsunePoster1x1Desc"/>
			<property name="SortOrder1" value="B709"/>
			<property name="SortOrder2" value="0000"/>
			<property name="Group" value="Decor/Miscellaneous"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
		</block>

		<block name="kitsunePoster2x2">
			<property name="Extends" value="kitsunePoster1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="blockMulti"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureSignable">
					<property name="FontSize" value="260"/>
					<property name="LineCount" value="4"/>
					<property name="LineWidth" value="1.8"/>
					<property name="LineSpacing" value="1"/>
				</property>
			</property>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?poster_2x2"/>
			<property name="MultiBlockDim" value="2,2,1"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="DescriptionKey" value="kitsunePoster1x1Desc"/>
			<property name="SortOrder2" value="0001"/>
		</block>

		<block name="kitsunePoster3x2">
			<property name="Extends" value="kitsunePoster1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="blockMulti"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureSignable">
					<property name="FontSize" value="380"/>
					<property name="LineCount" value="4"/>
					<property name="LineWidth" value="2.8"/>
					<property name="LineSpacing" value="1"/>
				</property>
			</property>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?poster_3x2"/>
			<property name="MultiBlockDim" value="3,2,1"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="DescriptionKey" value="kitsunePoster1x1Desc"/>
			<property name="SortOrder2" value="0002"/>
		</block>

		<!-- Graffiti decal: a near-invisible frame that shows the image ALONE,
		     with its PNG transparency kept - spray art straight on the wall.
		     While empty it shows a faint ghost board so it can be found. -->
		<block name="kitsuneGraffiti1x1">
			<property name="Extends" value="kitsunePoster1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?graffiti_1x1"/>
			<property name="DescriptionKey" value="kitsuneGraffiti1x1Desc"/>
			<property name="SortOrder2" value="0003"/>
		</block>

		<block name="kitsuneGraffiti2x2">
			<property name="Extends" value="kitsuneGraffiti1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="blockMulti"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureSignable">
					<property name="FontSize" value="260"/>
					<property name="LineCount" value="4"/>
					<property name="LineWidth" value="1.8"/>
					<property name="LineSpacing" value="1"/>
				</property>
			</property>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?graffiti_2x2"/>
			<property name="MultiBlockDim" value="2,2,1"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="DescriptionKey" value="kitsuneGraffiti1x1Desc"/>
			<property name="SortOrder2" value="0004"/>
		</block>

		<block name="kitsuneGraffiti3x2">
			<property name="Extends" value="kitsuneGraffiti1x1"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DisplayType" value="blockMulti"/>
			<property class="CompositeFeatures">
				<property class="TEFeatureSignable">
					<property name="FontSize" value="380"/>
					<property name="LineCount" value="4"/>
					<property name="LineWidth" value="2.8"/>
					<property name="LineSpacing" value="1"/>
				</property>
			</property>
			<property name="Model" value="#@modfolder:Resources/KitsunePosters.unity3d?graffiti_3x2"/>
			<property name="MultiBlockDim" value="3,2,1"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="DescriptionKey" value="kitsuneGraffiti1x1Desc"/>
			<property name="SortOrder2" value="0005"/>
		</block>

	</append>
</configs>
